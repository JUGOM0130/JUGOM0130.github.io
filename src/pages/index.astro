---
import ProjectCard from '../components/ProjectCard.astro';
import { services, skills, projects } from '../data/profile';

const title = 'JUGOM0130 | ポートフォリオ';
const description =
  '業務 Web システムから Windows デスクトップアプリまで、要件整理から実装・運用まで対応するエンジニアのポートフォリオです。';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <section class="hero">
        <p class="handle">JUGOM0130</p>
        <h1>業務システムから<br />Windows アプリまで、<br />一人で作りきります。</h1>
        <p class="lead">
          要件の整理・設計・実装・テスト・デプロイまでを一貫して担当します。
          Web (Python / TypeScript) とデスクトップ (Rust / C#) の両方に対応できるのが強みです。
        </p>
        <nav>
          <a href="#services">対応できること</a>
          <a href="#skills">スキル</a>
          <a href="#works">制作実績</a>
          <a href="#contact">ご依頼について</a>
        </nav>
      </section>

      <section id="services">
        <h2>対応できること</h2>
        <div class="grid">
          {services.map((s) => (
            <div class="service">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <p class="tech">{s.stack}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="skills">
        <h2>スキル</h2>
        <dl class="skills">
          {skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>
                <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="works">
        <h2>制作実績</h2>
        <p class="note">個人で設計・開発したものです。非公開のものは概要のみ掲載しています。</p>
        <div class="grid">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section id="contact">
        <h2>ご依頼について</h2>
        <p>
          ご相談・お見積もりは、ランサーズ / クラウドワークスのメッセージからお気軽にご連絡ください。
          「こういうことはできますか？」という段階のご相談も歓迎です。
        </p>
        <p><a href="https://github.com/JUGOM0130" target="_blank" rel="noopener">GitHub: JUGOM0130</a></p>
      </section>
    </main>
    <footer class="site-footer">© JUGOM0130</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f6f2;
    --surface: #ffffff;
    --text: #1f2422;
    --muted: #5d6662;
    --border: #e1ded6;
    --accent: #2f6b5a;
    --tag: #ebe8df;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151817;
      --surface: #1e2321;
      --text: #e6e9e7;
      --muted: #a0aaa5;
      --border: #2f3633;
      --accent: #7cc4ad;
      --tag: #2a302d;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic UI', 'Meiryo', sans-serif;
    line-height: 1.75;
  }
  a {
    color: var(--accent);
  }
</style>

<style>
  main {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 16px;
  }
  section {
    padding: 3.5rem 0 1rem;
  }
  .hero {
    padding-top: 5rem;
  }
  .handle {
    margin: 0;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    color: var(--accent);
    font-weight: 700;
  }
  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1.35;
  }
  .lead {
    max-width: 40em;
    color: var(--muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
  }
  h2 {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }
  .service {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .service h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }
  .service p {
    margin: 0;
  }
  .service .tech {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .skills {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: 0.5rem;
    align-items: baseline;
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    margin: 0;
  }
  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skills li {
    padding: 0.2rem 0.65rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.9rem;
  }
  @media (max-width: 600px) {
    .skills > div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
  .note {
    margin-top: -0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  #contact p {
    max-width: 40em;
  }
  .site-footer {
    padding: 3rem 16px 2rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
